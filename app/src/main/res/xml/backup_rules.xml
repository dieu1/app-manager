<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Dữ liệu nghiệp vụ được khôi phục từ Firestore sau khi đăng nhập.
         Không sao lưu SQLite, token đăng nhập hoặc cache sang tài khoản khác. -->
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
