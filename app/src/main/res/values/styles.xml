<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.TaskManager.SurfaceCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.TaskManager.HomeCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.TaskManager.Team.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/team_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/team_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.TaskManager.Team.Card.Flat" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/team_surface_alt</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.TaskManager.Team.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/team_primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="iconTint">@android:color/white</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.TaskManager.Team.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/team_primary_soft</item>
        <item name="android:textColor">@color/team_primary</item>
        <item name="iconTint">@color/team_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.TaskManager.Team.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/team_border</item>
        <item name="android:textColor">@color/team_text_primary</item>
        <item name="iconTint">@color/team_text_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.TaskManager.Team.Button.Danger" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/team_danger_soft</item>
        <item name="android:textColor">@color/team_danger</item>
        <item name="iconTint">@color/team_danger</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.TaskManager.Team.Eyebrow" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/team_white_82</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="TextAppearance.TaskManager.Team.PageTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.TaskManager.Team.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/team_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.TaskManager.Team.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/team_text_secondary</item>
    </style>
</resources>
