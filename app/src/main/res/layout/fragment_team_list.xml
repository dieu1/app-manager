<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/team_background"
    android:orientation="vertical"
    tools:context=".ui.team.TeamListFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_team_hero"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBackToPersonal"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:backgroundTint="@color/team_white_16"
                android:text="@string/home"
                android:textColor="@android:color/white"
                app:cornerRadius="13dp"
                app:icon="@drawable/ic_arrow_back"
                app:iconTint="@android:color/white" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/buttonTeamNotifications"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_team_white_translucent"
                android:contentDescription="@string/notifications"
                android:padding="10dp"
                android:src="@drawable/ic_notifications"
                app:tint="@android:color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRefreshTeams"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:backgroundTint="@color/team_white_16"
                android:contentDescription="@string/refresh"
                android:text="@string/refresh"
                android:textColor="@android:color/white"
                app:cornerRadius="13dp"
                app:icon="@drawable/ic_refresh"
                app:iconTint="@android:color/white" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/team_ui_eyebrow"
            android:textAppearance="@style/TextAppearance.TaskManager.Team.Eyebrow" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/team_workspaces"
            android:textAppearance="@style/TextAppearance.TaskManager.Team.PageTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/team_ui_list_subtitle"
            android:textColor="@color/team_white_82"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonAddTeam"
            style="@style/Widget.TaskManager.Team.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@android:color/white"
            android:text="@string/create_team"
            android:textColor="@color/team_primary"
            app:icon="@drawable/ic_add"
            app:iconTint="@color/team_primary" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonTeamInvites"
        style="@style/Widget.TaskManager.Team.Button.Tonal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:text="@string/team_invites_empty"
        android:visibility="gone"
        app:icon="@drawable/ic_email" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:text="@string/team_ui_your_workspaces"
        android:textAppearance="@style/TextAppearance.TaskManager.Team.SectionTitle" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerTeams"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            tools:listitem="@layout/item_team_workspace" />

        <ProgressBar
            android:id="@+id/progressTeams"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/team_primary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textEmptyTeams"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:background="@drawable/bg_team_input"
            android:drawablePadding="16dp"
            android:gravity="center"
            android:padding="28dp"
            android:text="@string/team_ui_empty_message"
            android:textAppearance="@style/TextAppearance.TaskManager.Team.Body"
            android:visibility="gone"
            app:drawableTint="@color/team_primary"
            app:drawableTopCompat="@drawable/ic_team" />
    </FrameLayout>
</LinearLayout>
