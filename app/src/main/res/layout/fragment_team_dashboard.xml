<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.team.dashboard.TeamDashboardFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBackTeamDashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back" />

            <TextView
                android:id="@+id/textTeamDashboardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textTeamDashboardRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressTeamDashboardRate"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:columnCount="2"
                android:rowCount="3">

                <TextView
                    android:id="@+id/textTeamDashboardTotal"
                    android:layout_width="0dp"
                    android:layout_height="78dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="?attr/colorSurfaceContainer"
                    android:gravity="center"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textTeamDashboardTodo"
                    android:layout_width="0dp"
                    android:layout_height="78dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="?attr/colorSurfaceContainer"
                    android:gravity="center"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textTeamDashboardInProgress"
                    android:layout_width="0dp"
                    android:layout_height="78dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="?attr/colorSurfaceContainer"
                    android:gravity="center"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textTeamDashboardCompleted"
                    android:layout_width="0dp"
                    android:layout_height="78dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="?attr/colorSurfaceContainer"
                    android:gravity="center"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textTeamDashboardCancelled"
                    android:layout_width="0dp"
                    android:layout_height="78dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="?attr/colorSurfaceContainer"
                    android:gravity="center"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textTeamDashboardOverdue"
                    android:layout_width="0dp"
                    android:layout_height="78dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:background="?attr/colorSurfaceContainer"
                    android:gravity="center"
                    android:textColor="@color/task_overdue"
                    android:textStyle="bold" />
            </GridLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/progress_by_project"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textDashboardNoProjects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/no_projects"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerDashboardProjects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_team_project_progress" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/progress_by_member"
                android:textSize="19sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerDashboardMembers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_team_member" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRefreshTeamDashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/refresh" />
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progressLoadingTeamDashboard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
