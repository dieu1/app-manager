<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp" android:background="@drawable/bg_detail_card"
    android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/textNotificationTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/task_navy"
        android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/textNotificationMessage" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:textColor="@color/task_text_secondary" android:textSize="14sp" />
    <TextView android:id="@+id/textNotificationTime" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:textColor="@color/task_text_secondary" android:textSize="12sp" />
</LinearLayout>
