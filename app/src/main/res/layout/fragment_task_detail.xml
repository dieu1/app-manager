<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FE">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layoutDetailFooter"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layoutTaskDetailContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Gradient -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_gradient"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/buttonBackTaskDetail"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/back"
                        android:src="@drawable/ic_arrow_back" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/buttonTaskDetailNotifications"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_team_white_translucent"
                        android:contentDescription="@string/notifications"
                        android:padding="9dp"
                        android:src="@drawable/ic_notifications"
                        android:visibility="gone"
                        app:tint="@android:color/white" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textTaskDetailTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:text="Tên công việc cực kỳ quan trọng" />

                <TextView
                    android:id="@+id/textTaskDetailStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_badge_neutral"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:textColor="#6C4FD6"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="ĐANG XỬ LÝ" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textTaskDetailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#49454F"
                    android:textSize="16sp"
                    tools:text="Đây là mô tả chi tiết của công việc này. Nó giúp người dùng hiểu rõ hơn về những gì cần làm." />

                <!-- Priority and Last Updated -->
                <LinearLayout
                    android:baselineAligned="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_detail_info_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_priority"
                            app:tint="#6C4FD6" />

                        <TextView
                            android:id="@+id/textTaskDetailPriority"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="#666666"
                            android:textSize="13sp"
                            tools:text="Ưu tiên: Cao" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_detail_info_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_update"
                            app:tint="#6C4FD6" />

                        <TextView
                            android:id="@+id/textTaskDetailUpdatedAt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="#666666"
                            android:textSize="13sp"
                            tools:text="Cập nhật: 2 giờ trước" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Progress Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_detail_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textTaskDetailProgress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            tools:text="Tiến độ tự động: 40%" />

                        <TextView
                            android:id="@+id/textTaskDetailSubtasksSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:textColor="#666666"
                            android:textSize="12sp"
                            tools:text="2/5 hoàn thành" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressTaskDetail"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="12dp"
                        android:max="100"
                        android:progressDrawable="@drawable/progress_status_colors"
                        tools:progress="40" />
                </LinearLayout>

                <!-- Subtasks Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textTaskSubtasksTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/task_subtasks_title"
                        android:textColor="#333333"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonAddSubtask"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/add_subtask"
                        android:textColor="#6C4FD6"
                        app:icon="@drawable/ic_add"
                        app:iconTint="#6C4FD6" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textTaskSubtasksEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="@string/subtask_empty"
                    android:textColor="#666666" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerTaskSubtasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    tools:listitem="@layout/item_subtask" />

                <LinearLayout
                    android:id="@+id/layoutTeamCollaboration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_detail_card"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/team_ui_collaboration"
                        android:textColor="@color/team_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonAddTaskComment"
                        style="@style/Widget.TaskManager.Team.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/add_comment"
                        app:icon="@drawable/ic_add" />

                    <TextView
                        android:id="@+id/textTaskComments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_team_input"
                        android:padding="12dp"
                        android:text="@string/no_comments" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonAddTaskAttachment"
                        style="@style/Widget.TaskManager.Team.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/add_attachment"
                        app:icon="@drawable/ic_add" />

                    <TextView
                        android:id="@+id/textTaskAttachments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autoLink="web"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_team_input"
                        android:padding="12dp"
                        android:text="@string/no_attachments" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonAddTaskDependency"
                        style="@style/Widget.TaskManager.Team.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/add_dependency"
                        app:icon="@drawable/ic_add" />

                    <TextView
                        android:id="@+id/textTaskDependencies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_team_input"
                        android:padding="12dp"
                        android:text="@string/no_dependencies" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/task_history"
                    android:textColor="#333333"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textTaskHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_detail_card"
                    android:padding="16dp"
                    android:text="@string/task_history_empty"
                    android:textColor="#666666"
                    android:textSize="13sp" />

                <!-- Dates Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_detail_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_calendar" />

                        <TextView
                            android:id="@+id/textTaskDetailStartDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:textColor="#49454F"
                            tools:text="Bắt đầu: 15/08/2026 08:00" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#F3F4F6" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_calendar"
                            app:tint="#E53935" />

                        <TextView
                            android:id="@+id/textTaskDetailDueDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:textColor="#49454F"
                            android:textStyle="bold"
                            tools:text="Kết thúc: 20/08/2026 18:00" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#F3F4F6" />

                    <TextView
                        android:id="@+id/textTaskDetailEstimated"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="#666666"
                        android:textSize="12sp"
                        tools:text="Thời lượng dự kiến: 120 phút" />

                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Footer Buttons -->
    <LinearLayout
        android:id="@+id/layoutDetailFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonEditTask"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="#F0EBFB"
            android:text="@string/edit_task"
            android:textColor="#6C4FD6"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDeleteTask"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="#FDECEA"
            android:text="@string/delete_task"
            android:textColor="#E53935"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressLoadingTaskDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_centerInParent="true"
        android:indeterminateTint="#6C4FD6"
        android:visibility="gone" />

</RelativeLayout>
