<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/team_background"
    tools:context=".ui.team.workspace.TeamWorkspaceFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_team_hero"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonBackTeams"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:backgroundTint="@color/team_white_16"
                        android:text="@string/back"
                        android:textColor="@android:color/white"
                        app:cornerRadius="13dp"
                        app:icon="@drawable/ic_arrow_back"
                        app:iconTint="@android:color/white" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/buttonWorkspaceNotifications"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_team_white_translucent"
                        android:contentDescription="@string/notifications"
                        android:padding="10dp"
                        android:src="@drawable/ic_notifications"
                        app:tint="@android:color/white" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textWorkspaceName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:textAppearance="@style/TextAppearance.TaskManager.Team.PageTitle"
                    tools:text="Nhóm phát triển sản phẩm" />

                <TextView
                    android:id="@+id/textWorkspaceDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/team_white_82"
                    android:textSize="14sp"
                    tools:text="Xây dựng và phát hành ứng dụng Task Manager" />

                <TextView
                    android:id="@+id/textCurrentTeamRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_team_white_translucent"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Vai trò: Chủ nhóm" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonTeamDashboard"
                    style="@style/Widget.TaskManager.Team.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="@android:color/white"
                    android:text="@string/open_team_dashboard"
                    android:textColor="@color/team_primary"
                    app:icon="@drawable/ic_update"
                    app:iconTint="@color/team_primary" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/team_ui_overview"
                android:textAppearance="@style/TextAppearance.TaskManager.Team.SectionTitle" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.TaskManager.Team.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/textTeamSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/team_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Tổng: 12 · Hoàn thành: 8 · Quá hạn: 1" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/team_ui_quick_actions"
                        android:textAppearance="@style/TextAppearance.TaskManager.Team.Body" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonEditTeam"
                            style="@style/Widget.TaskManager.Team.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:text="@string/edit_team"
                            app:icon="@drawable/ic_edit_pencil" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonLeaveTeam"
                            style="@style/Widget.TaskManager.Team.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:text="@string/leave_team"
                            app:icon="@drawable/ic_logout" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonDeleteTeam"
                        style="@style/Widget.TaskManager.Team.Button.Danger"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/disband_team" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/team_members"
                        android:textAppearance="@style/TextAppearance.TaskManager.Team.SectionTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/team_ui_members_subtitle"
                        android:textAppearance="@style/TextAppearance.TaskManager.Team.Body" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonAddMember"
                    style="@style/Widget.TaskManager.Team.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="@string/add_member"
                    app:icon="@drawable/ic_add" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTeamMembers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_team_member" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/team_projects"
                        android:textAppearance="@style/TextAppearance.TaskManager.Team.SectionTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/team_ui_projects_subtitle"
                        android:textAppearance="@style/TextAppearance.TaskManager.Team.Body" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonAddProject"
                    style="@style/Widget.TaskManager.Team.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="@string/add_project"
                    app:icon="@drawable/ic_add" />
            </LinearLayout>

            <TextView
                android:id="@+id/textNoProjects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_team_input"
                android:gravity="center"
                android:padding="20dp"
                android:text="@string/no_projects"
                android:textAppearance="@style/TextAppearance.TaskManager.Team.Body"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTeamProjects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_team_project" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/team_tasks"
                        android:textAppearance="@style/TextAppearance.TaskManager.Team.SectionTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/team_ui_tasks_subtitle"
                        android:textAppearance="@style/TextAppearance.TaskManager.Team.Body" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonAddTeamTask"
                    style="@style/Widget.TaskManager.Team.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@string/add_task"
                    app:icon="@drawable/ic_add" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.TaskManager.Team.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/team_ui_filters"
                        android:textColor="@color/team_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinnerProjectFilter"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_team_input" />

                    <Spinner
                        android:id="@+id/spinnerAssigneeFilter"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_team_input" />

                    <Spinner
                        android:id="@+id/spinnerTeamStatusFilter"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_team_input" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/textNoTeamTasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_team_input"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/no_team_tasks"
                android:textAppearance="@style/TextAppearance.TaskManager.Team.Body"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTeamTasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_team_task" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonLoadMoreTeamTasks"
                style="@style/Widget.TaskManager.Team.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/load_more_tasks"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progressTeamWorkspace"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/team_primary"
        android:visibility="gone" />
</FrameLayout>
